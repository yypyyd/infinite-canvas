# 管理员账号，仅首次启动且数据库中没有管理员时创建。密码至少 12 位。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT 登录密钥必须固定且至少 32 位；修改后现有登录会话会失效。
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 公开访问地址，用于生成上游可访问的本地参考素材地址、接收支付回调和社交分享卡片的绝对地址。
# 线上部署时填写站点根地址，例如：https://your-domain.example.com
# PUBLIC_BASE_URL=https://your-domain.example.com

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_DOC_URL=https://docs.canvas.best
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/yypyyd/infinite-canvas
NEXT_PUBLIC_VERSION_URL=https://raw.githubusercontent.com/yypyyd/infinite-canvas/main/VERSION
# Fork 可将发布镜像替换为自己的 GHCR 地址。
# INFINITE_CANVAS_IMAGE=ghcr.io/your-name/infinite-canvas:latest

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db
# 每个账号的云端媒体文件额度，单位 MB，默认 5GB
USER_STORAGE_QUOTA_MB=5120
# QINIU_DOWNLOAD_DOMAIN 必须配置为完整 HTTPS 地址。

# 独立批量生产 Worker。默认直接复用后台默认图片模型、渠道和计费规则，无需配置执行器地址。
# 正式环境应使用 MySQL/PostgreSQL，不要让 API 与 Worker 多进程共享 SQLite。
# 可选外部执行器接收任务创建时固化的品牌、商品、SKU、私有媒体临时地址、模板和任务项 JSON，须按“任务项 ID + 生产轮次”的 Idempotency-Key 幂等处理，并返回 {"resultUrl":"https://...","mimeType":"image/png","size":123456}。
# BATCH_WORKER_EXECUTOR_URL=https://worker-executor.example.com/generate
# 配置外部执行器时必填：BATCH_WORKER_TOKEN=replace-with-private-token
BATCH_WORKER_CONCURRENCY=4
# 单企业最多同时运行的生产项数量，不得高于全局并发数。
BATCH_WORKER_TENANT_CONCURRENCY=2

# ---------- 内置 API 网关（原 Nexa，超级管理员在后台“API 网关”中管理） ----------
# 启用后：对外 OpenAI 兼容接口 /api/gateway/v1/*（Bearer sk-*），管理接口 /api/admin/gateway/*（需超级管理员登录）。
# 幻图渠道可直接填 Base URL http://nexa.internal/v1（进程内调用，API Key 任填）。详见 docs/gateway.md。
GATEWAY_ENABLED=false
# 网关必须使用 PostgreSQL；表放在独立 schema（默认 gateway），可与幻图共用同一个库。
# docker compose --profile gateway 时：postgres://gateway:<GATEWAY_PG_PASSWORD>@gateway-postgres:5432/huantu?sslmode=disable
GATEWAY_POSTGRES_DSN=
GATEWAY_DB_SCHEMA=gateway
# GATEWAY_PG_PASSWORD=replace-with-strong-password
# Redis 用于并发、额度与设置缓存；建议独立 DB 编号，避免与其他服务的 setting:* 键冲突。
GATEWAY_REDIS_ADDR=gateway-redis:6379
GATEWAY_REDIS_PASSWORD=
GATEWAY_REDIS_DB=1
# 可选：生成结果对象存储（不配置则写入工作目录下 data/generated）
# GATEWAY_RUSTFS_ENDPOINT=http://gateway-rustfs:9000
# GATEWAY_RUSTFS_BUCKET=generated
# GATEWAY_RUSTFS_ACCESS_KEY=
# GATEWAY_RUSTFS_SECRET_KEY=
GATEWAY_APP_ENV=production
# 站点对外 HTTPS 源地址（仅协议+域名，不带路径；结果 URL 会自动拼 /api/gateway/v1/...）。
# GATEWAY_ENABLED=true 且 GATEWAY_APP_ENV=production 时必填，否则 Go 后端启动失败。
GATEWAY_PUBLIC_BASE_URL=https://your-domain.example.com
